{
  "name": "tmux-terminals",
  "version": "0.2.0",
  "description": "Self-hosted, phone-friendly web terminal for driving coding agents (Claude Code, Codex, aider, pi, or a shell) that run in tmux on your own machine.",
  "license": "MIT",
  "author": "Axo Insights (https://www.axoinsights.com)",
  "type": "module",
  "bin": {
    "tmux-terminals": "bin/tmux-terminals.mjs"
  },
  "files": [
    "bin",
    "dist",
    "web",
    "skills",
    "tmux.conf",
    "AGENTS.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "node scripts/prepare.mjs",
    "start": "node bin/tmux-terminals.mjs",
    "doctor": "node bin/tmux-terminals.mjs doctor",
    "test": "npm run build && node --test test/unit/*.test.mjs && node test/run-e2e.mjs",
    "test:unit": "npm run build && node --test test/unit/*.test.mjs"
  },
  "keywords": [
    "terminal",
    "tmux",
    "claude-code",
    "codex",
    "aider",
    "xterm",
    "pwa",
    "self-hosted",
    "agent-skills",
    "skill"
  ],
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.15.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  },
  "homepage": "https://github.com/axoinsights/tmux-terminals#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axoinsights/tmux-terminals.git"
  },
  "bugs": {
    "url": "https://github.com/axoinsights/tmux-terminals/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
